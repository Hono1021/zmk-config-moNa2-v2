#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        BT0: BT0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT0";
        };

        BT1: BT1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 1>;

            label = "BT1";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 新しいスクロール動作の追加

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <30>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;
            bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_layer {
            bindings = <
&kp Q             &kp W           &kp E         &kp R        &kp T                                            &kp Y       &kp U  &kp I      &kp O    &kp P
&kp A             &kp S           &kp D         &kp F        &kp G                             &kp SEMICOLON  &kp H       &kp J  &kp K      &kp L    &lt 4 MINUS
&kp Z             &kp X           &kp C         &kp V        &kp B        &mt 458979 34013240  &kp SQT        &kp N       &kp M  &kp COMMA  &kp DOT  &lt 10 SLASH
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_ALT  &lt 2 LANG2  &lt 4 LANG1  &lt 6 SPACE          &kp BACKSPACE  &kp RETURN                             &lt 4 DELETE
            >;

            sensor-bindings =
                <&scroll_up_down>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        mac_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                      &kp Y          &kp U  &kp I      &kp O       &kp P
&kp A             &kp S         &kp D         &kp F        &kp G                       &kp MINUS      &kp H          &kp J  &kp K      &kp L       &lt 4 SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B        &kp 34013235   &kp SEMICOLON  &kp N          &kp M  &kp COMMA  &kp PERIOD  &lt 11 SLASH
&kp LEFT_GUI      &kp LEFT_GUI  &kp LEFT_ALT  &lt 3 GRAVE  &lt 5 SPACE  &lt 7 MINUS    &kp RETURN     &kp BACKSPACE                                &kp RIGHT_SHIFT
            >;

            sensor-bindings =
                <&scroll_up_down>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        num_win {
            bindings = <
&kp 34013214      &kp 34013215    &kp 34013216  &kp 34013217  &kp 34013218                              &kp 537329699  &kp 537329700  &kp 537329701      &kp 537329702    &kp TAB
&kp C_BRI_UP      &kp C_BRI_DN    &trans        &trans        &kp TAB                 &kp 34013230      &kp INT1       &kp INT3       &kp RIGHT_BRACKET  &kp NON_US_HASH  &kp 34013240
&trans            &trans          &trans        &trans        &trans        &kp INT1  &kp LEFT_BRACKET  &trans         &trans         &kp COMMA          &kp PERIOD       &kp SLASH
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_ALT  &trans        &trans        &trans    &kp RETURN        &kp BACKSPACE                                                     &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        num_mac {
            bindings = <
&kp ESCAPE    &kp 34013214  &kp 34013215  &kp 34013216      &kp 34013217                             &kp EQUAL   &kp N7    &kp N8    &kp N9    &kp 34013221
&kp TAB       &kp 34013218  &kp 34013219  &kp 34013220      &kp 34013221               &kp 34013218  &kp N0      &kp N4    &kp N5    &kp N6    &kp MINUS    
&kp 34013233  &kp 34013222  &kp 34013223  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &kp 34013230  &kp PERIOD  &kp N1    &kp N2    &kp N3    &kp SLASH    
&kp LEFT_GUI  &kp LEFT_GUI  &kp LEFT_ALT  &trans            &trans             &trans  &kp RETURN    &kp BACKSPACE                             &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mouse_win {
            bindings = <
&mo 6   &trans  &trans  &trans  &trans                               &trans         &trans    &mkp MB3  &trans    &trans
&trans  &trans  &trans  &trans  &trans                  &trans       &mo 6          &mkp MB1  &mo 6     &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans    &kp 34013319  &trans       &trans         &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans    &trans        &kp PAGE_UP  &kp PAGE_DOWN                                &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mouse_mac {
            bindings = <
&kp ESCAPE            &kp 134676509  &kp UP         &kp 168230941  &kp 134676505                           &kp 34013219      &kp 34013220       &mkp MB3      &kp 34013222  &kp 34013223
&kp TAB               &kp LEFT       &kp 185008161  &kp RIGHT      &kp 134676484             &kp 34013229  &kp 34013214      &mkp MB1           &mo 7         &mkp MB2      &kp 17236012
&mt LEFT_SHIFT KP_N0  &kp 151453725  &kp DOWN       &kp 134676559  &kp 134676560  &kp EQUAL  &trans        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp 34013231  &kp 34013232  &kp 17236012
&kp LEFT_CONTROL      &trans         &trans         &trans         &trans         &trans     &kp RETURN    &kp BACKSPACE                                                    &kp 34013233
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        scroll_win {
            bindings = <
&kp 168230992  &kp 201785424  &kp UP         &kp 201785423  &kp 168230991                         &kp N7  &kp N8  &kp N9  &kp N0        &kp SLASH
&kp 134676560  &kp LEFT       &kp DOWN       &kp RIGHT      &kp 134676559          &kp SEMICOLON  &kp N4  &kp N5  &kp N6  &kp 34013235  &kp MINUS
&kp 67567696   &kp 168230994  &kp 201785426  &kp 201785425  &kp 67567695   &trans  &kp SQT        &kp N1  &kp N2  &kp N3  &kp EQUAL     &kp 537329716
&trans         &trans         &trans.        &trans         &trans         &trans  &kp COMMA      &kp PERIOD                            &kp 537329709
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        scroll_mac {
            bindings = <
&kp ESCAPE      &kp 50790443   &kp UP    &kp 17236011   &trans                               &trans  &trans    &mkp MB3  &trans    &trans
&kp HOME        &kp LEFT       &kp DOWN  &kp RIGHT      &kp END                &out OUT_TOG  &trans  &mkp MB1  &trans    &mkp MB2  &trans
&kp LEFT_SHIFT  &kp 168230992  &trans    &kp 168230991  &trans   &trans        &trans        &trans  &trans    &trans    &trans    &trans
&trans          &trans         &trans    &trans         &trans   &trans        &trans        &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        function_win {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                   &trans  &trans  &trans    &trans    &trans
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10                  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&kp F11 &kp F12 &trans  &trans  &kp PRINTSCREEN  &trans  &trans  &trans  &trans    &trans    &trans    &trans 
&trans  &trans  &trans  &trans  &trans           &trans  &trans  &trans                                &trans
            >;
        };

        function_mac {
            bindings = <
&kp A   &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans 
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };
	    ble_win {
            bindings = <
&BT0    &BT1          &BT2          &BT3          &BT4                           &BT0         &BT1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans            &trans       &trans       &trans  &trans        &trans        &trans
&trans  &trans        &trans        &trans        &trans  &trans    &bootloader  &trans       &trans  &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans    &trans       &bootloader                                      &bt BT_CLR_ALL
            >;
        };

        ble_mac {
            bindings = <
&kp F1  &kp F2        &kp F3        &kp F4        &kp F5                         &BT0         &BT1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp F6  &kp F7        &kp F8        &kp F9        &trans            &trans       &trans       &trans  &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans    &bootloader  &trans       &trans  &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans    &trans       &bootloader                                      &bt BT_CLR_ALL
            >;
        };
    };
};
